{
    "name": "client",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "android:sync": "cap sync android",
        "android:copy": "cap copy android",
        "android:open": "cap open android",
        "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/finish-apk.ps1",
        "android:assemble": "cd android && (./gradlew assembleRelease || gradlew.bat assembleRelease)",
        "android:bundle": "cd android && (./gradlew bundleRelease || gradlew.bat bundleRelease)",
        "android:clean": "cd android && (./gradlew clean || gradlew.bat clean)",
        "serve:apk": "node scripts/serve-apk.cjs",
        "qr:play": "node scripts/qr.js --play",
        "qr:url": "node scripts/qr.js --url",
        "deliver": "powershell -ExecutionPolicy Bypass -File scripts/deliver.ps1",
        "deliver:public": "powershell -ExecutionPolicy Bypass -File scripts/deliver.ps1 -PublicUrl"
    },
    "dependencies": {
        "@capacitor/android": "^7.4.3",
